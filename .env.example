# Copy to .env and fill in only if you use the optional cloud warehouse targets.
# The core lab (samples + run_eval.py) runs on local SQLite and needs none of these.

# --- PostgreSQL / Aurora target (warehouse_targets/publish_postgres.py) ---
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
# Set to 1 to mint a short-lived IAM auth token via boto3 instead of a password.
PG_USE_IAM_TOKEN=
PG_SSLMODE=require
PG_TARGET_DB=superstore
PG_BOOTSTRAP_DB=postgres

# --- Amazon Redshift target (warehouse_targets/publish_redshift.py) ---
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_DB=superstore
REDSHIFT_BOOTSTRAP_DB=dev

# --- AWS (only for IAM token auth) ---
AWS_REGION=us-east-1

# Directory holding the generated CSVs.
DATA_DIR=data
